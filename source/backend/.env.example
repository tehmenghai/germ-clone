# source/backend/.env
# Copy this file to .env and fill in your real values.
# Each dev gets their own Neon branch — do not share connection strings.
# .env is gitignored. Never commit it.

# Neon PostgreSQL — use postgresql+asyncpg:// for async SQLAlchemy / Alembic
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?sslmode=require

# Access gate — set false locally, true on deploy
PASSPHRASE_REQUIRED=false
APP_PASSPHRASE=

# Embedding — provider: ollama | google; model must match provider
# Default is ollama/nomic-embed-text (ADR-0004) — matches the live corpus.
# Switch to google/gemini-embedding-2 only after re-indexing the corpus with that model.
OLLAMA_URL=http://localhost:11434
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# Google AI Studio key — required for the Gemini embedding provider above, and used
# directly (bypassing llm/) by the ingestion/ scripts that do LLM-semantic chunking.
GEMINI_API_KEY=

# Inference toggle (ollama | cloud) — LLM only, not embeddings
INFERENCE_BACKEND=ollama

# Suppress LiteLLM startup warnings for unused providers (Bedrock, SageMaker)
LITELLM_LOG=ERROR

# Cloud provider (free tier) — only needed when INFERENCE_BACKEND=cloud
GROQ_API_KEY=
