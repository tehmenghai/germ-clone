# source/backend/.env
# Copy this file to .env and fill in your real values.
# Each dev gets their own Neon branch — do not share connection strings.
# .env is gitignored. Never commit it.

# Neon PostgreSQL — use postgresql+asyncpg:// for async SQLAlchemy / Alembic
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?sslmode=require

# Access gate — set false locally, true on deploy
PASSPHRASE_REQUIRED=false
APP_PASSPHRASE=

# Embedding — provider: ollama | google; model must match provider
# Default is google/gemini-embedding-2 — matches the live corpus in rag_chunks_ben0602.
# Switch to ollama/nomic-embed-text only after re-indexing the corpus with that model.
OLLAMA_URL=http://localhost:11434
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-2

# Inference toggle (ollama | cloud) — LLM only, not embeddings
INFERENCE_BACKEND=ollama

# Cloud provider (free tier) — only needed when INFERENCE_BACKEND=cloud
GROQ_API_KEY=
